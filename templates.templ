package main

import (
	"fmt"

	"github.com/LarsArtmann/emeet-pixyd/internal/pixy"
)

//go:generate templ generate
templ page(s webStatus) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>EMEET PIXY — { s.Camera }</title>
			<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#x1F4F7;</text></svg>"/>
			<link rel="stylesheet" href={ fmt.Sprintf("/static/style.css?v=%s", s.Version) }/>
		</head>
		<body>
			<main class="container">
				<header>
					<h1>EMEET PIXY</h1>
					if s.Online {
						<span class="header-badge header-badge-online">Online</span>
					} else {
						<span class="header-badge header-badge-offline">Offline</span>
					}
				</header>
				<div class="grid">
					<div>
						@previewSection(s)
					</div>
					@statusPanel(s)
				</div>
			</main>
			<div id="toast-container"></div>
			<script src={ fmt.Sprintf("/static/htmx-2.0.8.min.js?v=%s", s.Version) }></script>
			<script src={ fmt.Sprintf("/static/app.js?v=%s", s.Version) }></script>
		</body>
	</html>
}

templ previewSection(s webStatus) {
	<div id="preview-section" hx-get="/preview" hx-trigger="pixy:previewRefresh from:body" hx-swap="outerHTML">
		<div class="card">
			<div class="card-title-row">
				<div class="card-title">Preview</div>
				if s.Online && s.Device != "" {
					<button
						class={ "btn btn-mini", templ.KV("btn-active", s.PreviewPaused) }
						hx-post="/api/preview/toggle"
						hx-target="#preview-section"
						hx-swap="outerHTML"
						aria-label="Toggle preview pause"
					>
						if s.PreviewPaused {
							<svg class="btn-icon" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2 L10 6 L3 10 Z" fill="currentColor"></path></svg>
							<span>Resume</span>
						} else {
							<svg class="btn-icon" viewBox="0 0 12 12" aria-hidden="true"><rect x="3" y="2" width="2.5" height="8" fill="currentColor"></rect><rect x="6.5" y="2" width="2.5" height="8" fill="currentColor"></rect></svg>
							<span>Pause</span>
						}
					</button>
				}
			</div>
			<div class="preview-container" id="preview">
				if !s.Online || s.Device == "" {
					<div class="preview-placeholder">
						<div class="icon">&#x1F4F7;</div>
						<div>Camera offline</div>
					</div>
				} else if s.Camera == pixy.StatePrivacy {
					<div class="preview-placeholder" data-reason="privacy">
						<div class="icon">&#x1F576;</div>
						<div>Privacy mode: lens covered</div>
					</div>
				} else if s.PreviewPaused {
					<div class="preview-placeholder" data-reason="paused">
						<div class="icon">&#x23F8;</div>
						<div>Preview paused: device free for other apps</div>
					</div>
				} else {
					<div class="preview-live-dot"></div>
					<img src="/api/stream" id="preview-img" alt="Live camera feed" aria-label="Live camera preview"/>
					<div id="preview-fallback" class="preview-placeholder" style="display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column">
						<div class="icon">&#x1F4F7;</div>
						<div>Camera in use or unavailable</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ ptzPad() {
	<div class="ptz-pad-wrap">
		<div class="ptz-pad-axis ptz-pad-axis-top">tilt +</div>
		<div class="ptz-pad-axis ptz-pad-axis-bottom">tilt -</div>
		<div class="ptz-pad-axis ptz-pad-axis-left">pan -</div>
		<div class="ptz-pad-axis ptz-pad-axis-right">pan +</div>
		<svg class="ptz-pad" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-label="PTZ nudge pad">
			<g class="ptz-pad-outer">
				<path class="ptz-pad-wedge" data-axis="tilt" data-delta="10" d="M 39 39 A 86 86 0 0 1 161 39 L 139 61 A 55 55 0 0 0 61 61 Z"></path>
				<path class="ptz-pad-wedge" data-axis="pan" data-delta="10" d="M 161 39 A 86 86 0 0 1 161 161 L 139 139 A 55 55 0 0 0 139 61 Z"></path>
				<path class="ptz-pad-wedge" data-axis="tilt" data-delta="-10" d="M 161 161 A 86 86 0 0 1 39 161 L 61 139 A 55 55 0 0 0 139 139 Z"></path>
				<path class="ptz-pad-wedge" data-axis="pan" data-delta="-10" d="M 39 161 A 86 86 0 0 1 39 39 L 61 61 A 55 55 0 0 0 61 139 Z"></path>
			</g>
			<g class="ptz-pad-inner">
				<path class="ptz-pad-wedge" data-axis="tilt" data-delta="1" d="M 61 61 A 55 55 0 0 1 139 61 L 121 79 A 30 30 0 0 0 79 79 Z"></path>
				<path class="ptz-pad-wedge" data-axis="pan" data-delta="1" d="M 139 61 A 55 55 0 0 1 139 139 L 121 121 A 30 30 0 0 0 121 79 Z"></path>
				<path class="ptz-pad-wedge" data-axis="tilt" data-delta="-1" d="M 139 139 A 55 55 0 0 1 61 139 L 79 121 A 30 30 0 0 0 121 121 Z"></path>
				<path class="ptz-pad-wedge" data-axis="pan" data-delta="-1" d="M 61 139 A 55 55 0 0 1 61 61 L 79 79 A 30 30 0 0 0 79 121 Z"></path>
			</g>
			<circle class="ptz-pad-home" data-action="center" cx="100" cy="100" r="30"></circle>
			<text class="ptz-pad-label" x="100" y="32" text-anchor="middle">+10</text>
			<text class="ptz-pad-label" x="100" y="58" text-anchor="middle">+1</text>
			<text class="ptz-pad-label" x="100" y="151" text-anchor="middle">-1</text>
			<text class="ptz-pad-label" x="100" y="177" text-anchor="middle">-10</text>
			<text class="ptz-pad-label" x="172" y="104" text-anchor="middle">+10</text>
			<text class="ptz-pad-label" x="146" y="104" text-anchor="middle">+1</text>
			<text class="ptz-pad-label" x="54" y="104" text-anchor="middle">-1</text>
			<text class="ptz-pad-label" x="28" y="104" text-anchor="middle">-10</text>
			<path class="ptz-pad-home-icon" d="M 100 86 L 86 100 L 86 114 L 96 114 L 96 106 L 104 106 L 104 114 L 114 114 L 114 100 Z"></path>
		</svg>
	</div>
}

templ ptzSlider(label, axis string, min, max, value int, unit string) {
	<div class="slider-row" id={ "ptz-" + axis }>
		<span class="slider-label">{ label }</span>
		<input
			type="range"
			class="ptz-slider"
			id={ "slider-" + axis }
			name="value"
			min={ fmt.Sprintf("%d", min) }
			max={ fmt.Sprintf("%d", max) }
			value={ fmt.Sprintf("%d", value) }
			hx-post={ "/api/ptz/" + axis }
			hx-target={ "#ptz-" + axis }
			hx-swap="outerHTML"
			hx-trigger="input changed delay:300ms"
		/>
		<span class="slider-value" id={ "val-" + axis }>{ fmt.Sprintf("%d%s", value, unit) }</span>
	</div>
}

templ ptzSliderWithToast(label, axis string, min, max, value int, unit string, toastMsg string, toastType string) {
	@ptzSlider(label, axis, min, max, value, unit)
	@toastOOB(toastMsg, toastType)
}

templ toastOOB(msg, toastType string) {
	<div id="toast-container" hx-swap-oob="innerHTML">
		if msg != "" {
			<div class={ "toast toast-" + toastType + " show" }>{ msg }</div>
		}
	</div>
}

templ stateIndicator(prefix, value string) {
	<div class={ prefix + "-indicator", prefix + "-" + value }>
		<span class={ prefix + "-dot" }></span>
		<span>{ value }</span>
	</div>
}

templ cameraBtn(color string, endpoint string, label string, shortcut string, ariaLabel string, active bool, online bool) {
	<button
		class={ "btn", color, templ.KV("btn-active", active) }
		hx-post={ endpoint }
		hx-target="#status-panel"
		aria-label={ ariaLabel }
		if !online {
			disabled=""
		}
	>
		{ label }<span class="kbd">{ shortcut }</span>
	</button>
}

templ audioBtn(color string, mode string, label string, ariaLabel string, active bool, online bool) {
	<button
		class={ "btn", templ.KV(color, color != ""), templ.KV("btn-active", active) }
		hx-post="/api/audio"
		hx-vals={ fmt.Sprintf(`{"mode":"%s"}`, mode) }
		hx-target="#status-panel"
		aria-label={ ariaLabel }
		if !online {
			disabled=""
		}
	>
		{ label }
	</button>
}

templ statusPanel(s webStatus) {
	<div id="status-panel" hx-get="/panel" hx-trigger="every 30s, refresh from:body" hx-swap="outerHTML" hx-indicator="#status-panel" style="position:relative">
		if s.Error != "" {
			<div class="error-banner" role="alert">{ s.Error }</div>
		}
		<div class="card">
			<div class="card-title">Camera</div>
			@stateIndicator("state", string(s.Camera))
			<div class="btn-group">
				@cameraBtn("btn-green", "/api/track", "Track", "T", "Enable tracking", s.Camera == pixy.StateTracking, s.Online)
				@cameraBtn("btn-yellow", "/api/idle", "Idle", "I", "Set idle", s.Camera == pixy.StateIdle, s.Online)
				@cameraBtn("btn-red", "/api/privacy", "Privacy", "P", "Enable privacy", s.Camera == pixy.StatePrivacy, s.Online)
			</div>
		</div>
		<div class="card">
			<div class="card-title">Audio Mode</div>
			@stateIndicator("audio", string(s.Audio))
			<div class="btn-group">
				@audioBtn("btn-green", "nc", "Noise Cancel", "Noise cancel", s.Audio == pixy.AudioNC, s.Online)
				@audioBtn("btn-yellow", "live", "Live", "Live audio", s.Audio == pixy.AudioLive, s.Online)
				@audioBtn("", "org", "Original", "Original audio", s.Audio == pixy.AudioOriginal, s.Online)
			</div>
		</div>
		<div class="card">
			<div class="card-title">Settings</div>
			<div class="toggle-row">
				<span class="toggle-label" id="gesture-label">Gesture Control</span>
				<button
					class={ "toggle", templ.KV("on", s.Gesture) }
					hx-post="/api/gesture"
					hx-target="#status-panel"
					aria-labelledby="gesture-label"
					role="switch"
					aria-checked={ fmt.Sprintf("%t", s.Gesture) }
					if !s.Online {
						disabled=""
					}
				></button>
			</div>
			<div class="toggle-row">
				<span class="toggle-label" id="auto-label">
					Auto Mode
					if !s.Auto.IsOff() {
						<span class="meta">{ s.Auto.String() }</span>
					}
				</span>
				<button
					class={ "toggle", templ.KV("on", !s.Auto.IsOff()) }
					hx-post="/api/auto"
					hx-target="#status-panel"
					aria-labelledby="auto-label"
					role="switch"
					aria-checked={ fmt.Sprintf("%t", !s.Auto.IsOff()) }
				></button>
			</div>
			if s.InCall {
				<div class="meta meta-call">
					<span>&#x25CF; In call</span>
				</div>
			}
		</div>
		if s.Online {
			<div class="card">
				<div class="card-title">PTZ</div>
				@ptzSlider("Pan", "pan", s.PanLo, s.PanHi, s.Pan, "°")
				@ptzSlider("Tilt", "tilt", s.TiltLo, s.TiltHi, s.Tilt, "°")
				@ptzSlider("Zoom", "zoom", s.ZoomLo, s.ZoomHi, s.Zoom, "x")
				@ptzPad()
				<div class="spacer"></div>
				<div class="btn-group">
					<button class="btn" hx-post="/api/center" hx-target="#status-panel" aria-label="Center camera">Center<span class="kbd">C</span></button>
					<button class="btn" hx-post="/api/reset" hx-target="#status-panel" aria-label="Reset PTZ to factory zero">Reset</button>
				</div>
			</div>
		}
		<div class="card">
			<div class="footer-actions">
				<button class="btn" hx-post="/api/sync" hx-target="#status-panel" aria-label="Sync state">&#x21BB; Sync</button>
				<button class="btn" hx-post="/api/probe" hx-target="#status-panel" aria-label="Probe devices">&#x1F50D; Probe</button>
			</div>
			if s.LastSynced != "" {
				<div class="last-synced">Last synced: { s.LastSynced } · v{ s.Version }</div>
			} else if s.Version != "" {
				<div class="last-synced">v{ s.Version }</div>
			}
		</div>
	</div>
	@toastOOB(s.Toast, s.ToastType)
}
